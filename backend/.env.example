# Supabase
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=replace-me
# OpenAI
OPENAI_API_KEY=replace-me
OPENAI_SEGMENTATION_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Token limit: per-request output cap for segmentation (see backend/config.toml).
# E.g. 3000 for a model whose token limit is 3000.
OPENAI_SEGMENTATION_MAX_TOKENS=3000
# App (defaults live in backend/config.toml; env wins on conflict)
AUDIOBOOKS_BUCKET=audiobooks
MAX_TTS_CHUNK_CHARS=4000
FRONT_MATTER_MIN_PAGES=15
FRONT_MATTER_MAX_PAGES=25
# Full-book background pipeline
EXTRACTION_BATCH_PAGES=25
SEGMENTATION_TOKEN_LIMIT=3000
SEGMENTATION_CHARS_PER_TOKEN=4.0
SEGMENTATION_TEXT_SPLITTER=stdlib
SEGMENTATION_TEXT_SPLITTER_OVERLAP_CHARS=0
SEGMENTATION_MAX_RETRIES=1
TTS_MAX_CONCURRENCY=4
TTS_CHUNK_CONCURRENCY=5
